#!/usr/bin/env bash
# Build every variant that needs a build step, then serve the
# benchmark dir via `idealyst-cli serve`. Run from anywhere:
#
#   benchmark/serve              # default port 8080
#   PORT=9000 benchmark/serve    # custom port
#
# Variants that load from esm.sh (vanilla-*, react-*, vue) need
# no build. Only the Svelte variant + the three wasm crates (runner,
# idealyst-native, idealyst-native-anim) do.
# Each step is idempotent — re-running is safe.

set -e

BENCH_DIR="$(cd "$(dirname "$0")" && pwd)"
WORKSPACE_ROOT="$(cd "$BENCH_DIR/.." && pwd)"

# The three wasm crates link backend-web, whose bindings are web-glue:
# its JS rides inside the wasm and has to come back out as
# `pkg/__idealyst_glue.js`. wasm-pack can't write that file (its output
# builds, then 404s on the import and never boots), so each crate goes
# through `bench-pack-web` — cargo + the framework's hybrid glue pass +
# wasm-bindgen + wasm-opt with the crate's own
# `[package.metadata.wasm-pack.profile.release]` flags. See
# benchmark/pack-web/src/main.rs.
pack() {
  # `cargo run` execs the tool, so its own cargo build of the wasm crate
  # doesn't contend for the build lock.
  (cd "$WORKSPACE_ROOT" && cargo run -q --release -p bench-pack-web -- "$1")
}

echo
echo "[bench] building runner wasm..."
pack "$BENCH_DIR"

echo
echo "[bench] building idealyst-native variant wasm..."
pack "$BENCH_DIR/idealyst-native/wasm"

echo
echo "[bench] building idealyst-native-anim variant wasm..."
pack "$BENCH_DIR/idealyst-native-anim/wasm"

echo
echo "[bench] building svelte variant..."
(
  cd "$BENCH_DIR/svelte"
  # npm install only if node_modules is missing — first run is
  # slow, subsequent runs skip straight to the build.
  if [ ! -d node_modules ]; then
    echo "[bench]   installing svelte deps (first run only)..."
    npm install --silent
  fi
  npm run build --silent
)

echo
echo "[bench] starting server on port ${PORT:-8080}..."
cd "$WORKSPACE_ROOT"
exec cargo run -q -p idealyst-cli -- serve benchmark --port "${PORT:-8080}"
