{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280x900"
      ],
      "env": {}
    },
    "idealyst": {
      "type": "stdio",
      "command": "idealyst",
      "args": ["mcp"],
      "env": {}
    }
  }
}