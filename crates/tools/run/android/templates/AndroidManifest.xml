<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by `idealyst run android` / an Android `idealyst build`.
     One launchable Activity plus whatever the dependency graph's SDKs and
     the app's `[package.metadata.idealyst.app.android]` add. The label is
     inline (no string resources). `uses-sdk` and the version code/name
     come from aapt2 link flags, not this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="{{PACKAGE}}">
    <!-- Capability-derived permissions, injected from SDKs declared in
         the dependency graph (`[package.metadata.idealyst].capabilities`). -->
    {{USES_PERMISSIONS}}
    <!-- Elements SDKs splice inside <manifest>
         (`[package.metadata.idealyst.android].manifest_root`). -->
    {{SDK_MANIFEST_ROOT}}
    <!-- `usesCleartextTraffic`: Android 9+ blocks plain HTTP by default,
         which stops a dev build from reaching a server-function / `#[sse]`
         host running over `http://` on the developer's machine (the emulator
         reaches the host loopback via `http://10.0.2.2:<port>`). It is "true"
         for `idealyst run` / `dev` only; a release APK from
         an Android `idealyst build` renders "false", Android's secure default. -->
    <application
        android:label="{{APP_NAME}}"
        android:usesCleartextTraffic="{{CLEARTEXT}}"
        android:hasCode="true"{{ICON_ATTRS}}>
        <!-- `configChanges` keeps the Activity alive across rotation,
             multi-window resize, keyboard show/hide, dark-mode toggle,
             density change, etc. Without it Android tears the Activity
             down and recreates it, which restarts the framework mount
             (animations replay, signal state is lost) and computes
             layout for the wrong viewport. The framework reacts to
             these events by re-running its layout pass; see
             `onConfigurationChanged` in MainActivity. -->
        <!-- `singleTask`: an inbound link (custom scheme / App Link) while
             the app runs is re-delivered to THIS Activity's `onNewIntent`
             instead of stacking a second instance in the caller's task,
             which would `attach` and mount a second copy of the app. -->
        <activity android:name="{{PACKAGE}}.MainActivity"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|navigation|fontScale|layoutDirection"
                  android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"{{MAIN_ACTIVITY_ATTRS}}>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- HOME + DEFAULT when the app is a home screen
                 (`[package.metadata.idealyst.app.android].home_launcher`). -->
            {{HOME_INTENT_FILTER}}
            <!-- Inbound links from `[package.metadata.idealyst.app.links]`:
                 a VIEW filter for the custom schemes, an autoVerify https
                 filter per domain. Empty when the app declares none. -->
            {{INTENT_FILTERS}}
        </activity>
        <!-- Robot bridge relay URL, baked by `idealyst dev` (empty otherwise).
             MainActivity reads it and hands it to Rust before `attach` so the
             app dials the host relay (reached via `adb reverse`) instead of
             self-hosting an on-device TCP bridge. -->
        <meta-data android:name="IdealystRobotRelayUrl" android:value="{{ROBOT_RELAY_URL}}" />
        <!-- Dev-tooling environment for the app process (`KEY=VALUE`, `;`-separated),
             e.g. `IDEALYST_TEST_DRIVER=1` from `idealyst test` so an in-app
             self-test stands down. A desktop app inherits these from the dev
             process; an Android app has no environment to inherit. Empty
             otherwise. -->
        <meta-data android:name="IdealystEnv" android:value="{{IDEALYST_ENV}}" />
        <!-- Capability-derived services (e.g. the screen_capture
             mediaProjection foreground service), injected from SDKs in the
             dependency graph the same way `{{USES_PERMISSIONS}}` is. -->
        {{SERVICES}}
        <!-- Components SDKs splice inside <application>
             (`[package.metadata.idealyst.android].manifest_application`). -->
        {{SDK_MANIFEST_APPLICATION}}
    </application>
</manifest>
