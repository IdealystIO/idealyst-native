<?xml version="1.0" encoding="utf-8"?>
<!-- What the service may do, shown to the person switching it on.
     canTakeScreenshot (API 30) for `screenshot`, canPerformGestures for the
     gestures, canRetrieveWindowContent for `set_focused_text` (it finds the
     input-focused node). flagRetrieveInteractiveWindows makes Android track
     every window for the service: without it takeScreenshotOfWindow, which
     `screenshot` uses to detect a secure window, fails with "invalid
     window". The service reads no events: the one type here is the minimum
     the attribute takes, and the service ignores it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true" />
