<?xml version="1.0" encoding="utf-8"?>
<!-- The legacy device-admin policy list. A device owner is granted every
     DevicePolicyManager call regardless; these are the ones Android still
     checks against the list for an admin. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
