<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
<!-- start_keep_alive: a foreground service of the device-owner type. -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
<!-- PackageInstaller sessions (install_apk) and uninstall(): apps targeting
     API 26+ / 28+ must hold these even as device owner. -->
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
<uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
<!-- installed_version() and launch() look up OTHER packages (the kiosk),
     which Android 11+ package visibility hides without this. -->
<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
