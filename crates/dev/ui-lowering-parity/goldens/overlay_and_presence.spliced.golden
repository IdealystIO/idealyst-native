=== full ===
-- mount --
create n0 view
create n1 view
apply_default_text_font none
register_stylesheet rules=1
apply_style n1 width=none
insert_at n0 <- n1 @ 0
create n2 presence_placeholder
insert n0 <- n2

-- open=true --
remove_child n0 -x n1
on_node_unstyled n1
release_subtree n1
create n3 view
create n4 portal
create n5 pressable
create n6 view
apply_style n6 width=none
install_touch_handler n6
insert n5 <- n6
insert n4 <- n5
create n7 view
create n8 text "modal"
insert n7 <- n8
insert n4 <- n7
insert n3 <- n4
create n9 portal
create n10 view
create n11 text "tip"
insert n10 <- n11
insert n9 <- n10
insert n3 <- n9
insert_at n0 <- n3 @ 0

-- toast=true --
create n12 text "toast"
insert_at n2 <- n12 @ 0
apply_presence n12 op=Some(0.0) ty=None snap
apply_presence n12 rest 100ms

-- unmount --
on_node_unstyled n6
release_portal n4
release_portal n9

=== scene ===
n0 view
  n3 view
    n4 portal
      n5 pressable
        n6 view
      n7 view
        n8 text "modal"
    n9 portal
      n10 view
        n11 text "tip"
  n2 presence_placeholder
    n12 text "toast"
n1 view
