=== full ===
-- mount --
create n0 view
create n1 view
apply_default_text_font none
register_stylesheet rules=1
apply_style n1 width=none
insert_at n0 <- n1 @ 0
create n2 presence_placeholder
insert n0 <- n2

-- open=true --
remove_child n0 -x n1
on_node_unstyled n1
release_subtree n1
create n3 view
create n4 portal
create n5 pressable
create n6 view
apply_style n6 width=none
install_touch_handler n6
insert n5 <- n6
apply_style n5 width=none
insert n4 <- n5
apply_style n4 width=none
insert n3 <- n4
create n7 portal
create n8 view
create n9 text "modal"
insert n8 <- n9
apply_style n8 width=none
insert n7 <- n8
apply_style n7 width=none
insert n3 <- n7
create n10 portal
create n11 view
create n12 text "tip"
insert n11 <- n12
apply_style n11 width=none
insert n10 <- n11
apply_style n10 width=none
insert n3 <- n10
insert_at n0 <- n3 @ 0

-- toast=true --
create n13 text "toast"
insert_at n2 <- n13 @ 0
apply_presence n13 op=Some(0.0) ty=None snap
apply_presence n13 rest 100ms

-- unmount --
on_node_unstyled n6
on_node_unstyled n5
on_node_unstyled n4
release_portal n4
on_node_unstyled n8
on_node_unstyled n7
release_portal n7
on_node_unstyled n11
on_node_unstyled n10
release_portal n10

=== scene ===
n0 view
  n3 view
    n4 portal
      n5 pressable
        n6 view
    n7 portal
      n8 view
        n9 text "modal"
    n10 portal
      n11 view
        n12 text "tip"
  n2 presence_placeholder
    n13 text "toast"
n1 view
