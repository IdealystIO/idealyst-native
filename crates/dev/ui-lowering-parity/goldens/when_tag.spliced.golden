=== full ===
-- mount --
create n0 view
create n1 text "no"
insert_at n0 <- n1 @ 0

-- flag=true --
remove_child n0 -x n1
release_subtree n1
create n2 text "yes"
insert_at n0 <- n2 @ 0

-- unmount --
(none)

=== scene ===
n0 view
  n2 text "yes"
n1 text "no"
