=== full ===
-- mount --
create n0 view
create n1 anchor
create n2 text "small"
insert n1 <- n2
insert n0 <- n1

-- n=5 --
release_subtree n2
clear_children n1
create n3 text "big"
insert n1 <- n3

-- unmount --
(none)

=== scene ===
n0 view
  n1 anchor
    n3 text "big"
n2 text "small"
