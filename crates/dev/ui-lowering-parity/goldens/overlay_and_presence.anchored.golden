=== full ===
-- mount --
create n0 view
create n1 anchor
create n2 view
apply_default_text_font none
register_stylesheet rules=1
apply_style n2 width=none
insert n1 <- n2
insert n0 <- n1
create n3 presence_placeholder
create n4 anchor
insert n3 <- n4
insert n0 <- n3

-- open=true --
on_node_unstyled n2
release_subtree n2
clear_children n1
create n5 view
create n6 portal
create n7 pressable
create n8 view
apply_style n8 width=none
install_touch_handler n8
insert n7 <- n8
apply_style n7 width=none
insert n6 <- n7
apply_style n6 width=none
insert n5 <- n6
create n9 portal
create n10 view
create n11 text "modal"
insert n10 <- n11
apply_style n10 width=none
insert n9 <- n10
apply_style n9 width=none
insert n5 <- n9
create n12 portal
create n13 view
create n14 text "tip"
insert n13 <- n14
apply_style n13 width=none
insert n12 <- n13
apply_style n12 width=none
insert n5 <- n12
insert n1 <- n5

-- toast=true --
create n15 text "toast"
insert n4 <- n15
apply_presence n15 op=Some(0.0) ty=None snap
apply_presence n15 rest 100ms

-- unmount --
on_node_unstyled n8
on_node_unstyled n7
on_node_unstyled n6
release_portal n6
on_node_unstyled n10
on_node_unstyled n9
release_portal n9
on_node_unstyled n13
on_node_unstyled n12
release_portal n12

