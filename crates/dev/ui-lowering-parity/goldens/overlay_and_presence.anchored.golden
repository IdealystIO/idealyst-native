=== full ===
-- mount --
create n0 view
create n1 anchor
create n2 view
apply_default_text_font none
register_stylesheet rules=1
apply_style n2 width=none
insert n1 <- n2
insert n0 <- n1
create n3 presence_placeholder
create n4 anchor
insert n3 <- n4
insert n0 <- n3

-- open=true --
on_node_unstyled n2
release_subtree n2
clear_children n1
create n5 view
create n6 portal
create n7 pressable
create n8 view
apply_style n8 width=none
install_touch_handler n8
insert n7 <- n8
insert n6 <- n7
create n9 view
create n10 text "modal"
insert n9 <- n10
insert n6 <- n9
insert n5 <- n6
create n11 portal
create n12 view
create n13 text "tip"
insert n12 <- n13
insert n11 <- n12
insert n5 <- n11
insert n1 <- n5

-- toast=true --
create n14 text "toast"
insert n4 <- n14
apply_presence n14 op=Some(0.0) ty=None snap
apply_presence n14 rest 100ms

-- unmount --
on_node_unstyled n8
release_portal n6
release_portal n11

