n0 view
  n1 anchor
    n5 view
      n6 portal
        n7 pressable
        n8 view
          n9 text "modal"
      n10 portal
        n11 view
          n12 text "tip"
  n3 presence_placeholder
    n4 anchor
      n13 text "toast"
n2 view
