=== full ===
-- mount --
create n0 view
create n1 view
create n2 view
create n3 text "x"
insert n2 <- n3
insert_at n1 <- n2 @ 0
insert_at n0 <- n1 @ 0

-- flag=false --
remove_child n0 -x n1
release_subtree n1
create n4 text "hidden"
insert_at n0 <- n4 @ 0

-- unmount --
(none)

=== scene ===
n0 view
  n4 text "hidden"
n1 view
  n2 view
    n3 text "x"
