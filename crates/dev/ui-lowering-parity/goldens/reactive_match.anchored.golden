=== full ===
-- mount --
create n0 view
create n1 anchor
create n2 text "idle"
insert n1 <- n2
insert n0 <- n1

-- mode=Busy --
release_subtree n2
clear_children n1
create n3 text "busy"
insert n1 <- n3

-- mode=Done --
release_subtree n3
clear_children n1
create n4 text "done"
insert n1 <- n4

-- unmount --
(none)

=== scene ===
n0 view
  n1 anchor
    n4 text "done"
n2 text "idle"
n3 text "busy"
