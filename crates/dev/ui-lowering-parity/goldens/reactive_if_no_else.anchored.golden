(none)

=== full ===
-- mount --
create n0 view
create n1 text "always"
insert n0 <- n1
create n2 anchor
create n3 view
apply_default_text_font none
register_stylesheet rules=1
apply_style n3 width=none
insert n2 <- n3
insert n0 <- n2

-- flag=true --
on_node_unstyled n3
release_subtree n3
clear_children n2
create n4 text "sometimes"
insert n2 <- n4

-- unmount --
(none)

=== scene ===
n0 view
  n1 text "always"
  n2 anchor
    n4 text "sometimes"
n3 view
