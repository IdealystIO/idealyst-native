# scene-parity golden — scenario `each_remove_middle`, mode `spliced`
#
# Keyed list [1,2,3] -> [1,3]: the removed row's node is
# remove_child'd; survivors kept their relative order (old
# positions strictly increasing) so NO insert_at fires at all —
# surviving rows are never touched (focus/IME preservation).
#
# Structural ops only. Node names are creation-order (n0, n1, ...);
# `cleanup <label>` lines are scenario-registered on_cleanup markers
# pinning dispose ordering. Regenerate after an INTENDED behavior
# change with: UPDATE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 text "header"
insert n0 <- n1
create n2 text "row-1"
create n3 text "row-2"
create n4 text "row-3"
insert_at n0 <- n2 @ 1
insert_at n0 <- n3 @ 2
insert_at n0 <- n4 @ 3
create n5 text "footer"
insert n0 <- n5

== remove middle -> [1,3] ==
remove_child n0 -x n3
