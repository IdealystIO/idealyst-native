# scene-parity golden — scenario `each_insert_middle_survivors`, mode `spliced`
#
# Keyed list [1,2,4] -> [1,2,3,4]: one NEW row in the middle.
# Survivor old positions (0,1,2) stay strictly increasing ->
# reorder=false -> ONLY the new row emits insert_at (at
# base_index+2). Existing rows — including 4, which shifts
# visually — emit NO moves; the backend's insert_at displaces it.
#
# Structural ops only. Node names are creation-order (n0, n1, ...);
# `cleanup <label>` lines are scenario-registered on_cleanup markers
# pinning dispose ordering. Regenerate after an INTENDED behavior
# change with: UPDATE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 text "header"
insert n0 <- n1
create n2 text "row-1"
create n3 text "row-2"
create n4 text "row-4"
insert_at n0 <- n2 @ 1
insert_at n0 <- n3 @ 2
insert_at n0 <- n4 @ 3
create n5 text "footer"
insert n0 <- n5

== insert 3 mid-list -> [1,2,3,4] (survivors must NOT move) ==
create n6 text "row-3"
insert_at n0 <- n6 @ 3
