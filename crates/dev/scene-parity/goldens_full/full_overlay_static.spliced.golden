# scene-parity FULL-OP golden — scenario `full_overlay_static`, mode `spliced`
#
# P3-set: the overlay compositions, static mount only. A modal
# overlay (Dismiss backdrop pressable + styled content wrapper +
# Bottom placement), a click-through overlay (no backdrop; portal
# root pinned pointer-events:none — the empty-ToastHost fix), and
# an anchored overlay (side/align/offset intent digested; backdrop
# None so no scrim child). Pins the composition lowering:
# backdrop-first-then-content child order and each portal's
# create_* argument rendering.
#
# Complete backend-call stream (create_*/update_*/apply_style/release_*
# + the structural ops). Node names are creation-order (n0, n1, ...).
# Owned by the OLD core; regenerate after an INTENDED walker change
# with: UPDATE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 portal target=viewport(Bottom) on_dismiss=<fn> trap_focus=true
create n2 pressable on_click=<fn>
apply_style n2 {background: Some(Literal(Color("#00000080"))), width: Some(Literal(Px(40.0)))}
insert n1 <- n2
create n3 view
create n4 text "modal body"
insert n3 <- n4
apply_style n3 {background: Some(Literal(Color("#ffffff"))), width: Some(Literal(Px(320.0)))}
insert n1 <- n3
insert n0 <- n1
create n5 portal target=viewport(Center) on_dismiss=none trap_focus=true
create n6 view
create n7 text "toast"
insert n6 <- n7
insert n5 <- n6
apply_style n5 {pointer_events: Some(None)}
insert n0 <- n5
create n8 portal target=anchor(side=Above align=Center offset=4) on_dismiss=none trap_focus=false
create n9 view
create n10 text "tip"
insert n9 <- n10
insert n8 <- n9
insert n0 <- n8
