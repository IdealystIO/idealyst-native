# scene-parity FULL-OP golden — scenario `full_virtualizer_lifecycle`, mode `spliced`
#
# P3-set: the virtualizer's full callback contract, driven by the
# recorder's window sim (the recycler stand-in). Mount pins
# create_virtualizer(overscan, lane-model layout) -> the data
# effect's first virtualizer_data_changed -> apply_style. Rows
# realize LAZILY and DETACHED via mount_item (create + binding
# first-fire, no insert — placement is the backend's business);
# a shared-signal write updates every LIVE row exactly once;
# release_item frees the row's reactivity (released rows never
# update again); the measured-size cache is keyed by item KEY and
# survives release (the re-entering row mounts at its measured
# size, not the estimate); a count change re-fires
# virtualizer_data_changed; the swap-out (window cleared first)
# tears the node down. Two interleavings inside this golden are
# kernel-ordering artifacts, not contract: the live-row update
# order across sibling effects (README divergence #3) and the
# unstyle/release order inside the teardown window (divergence
# #5, old LIFO vs new creation order) — the new core pins its
# orderings via an override golden.
#
# Complete backend-call stream (create_*/update_*/apply_style/release_*
# + the structural ops). Node names are creation-order (n0, n1, ...).
# Owned by the OLD core; regenerate after an INTENDED walker change
# with: UPDATE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 virtualizer overscan=2 layout=VirtualLayout { axis: Vertical, lanes: Fixed(1), main_spacing: 0.0, cross_spacing: 0.0 }
virtualizer_data_changed n1
apply_style n1 {background: Some(Literal(Color("#334455"))), width: Some(Literal(Px(120.0)))}
insert_at n0 <- n1 @ 0

== fill window 0..3 (lazy detached row mounts) ==
vsim window 0..3 count=3 keys=[0, 1, 2]
create n2 text+id2 ""
update_text_by_id id2 "item 0 v0"
vsim mounted idx=0 key=0 size=40 -> n2 scope=0
create n3 text+id3 ""
update_text_by_id id3 "item 1 v0"
vsim mounted idx=1 key=1 size=40 -> n3 scope=1
create n4 text+id4 ""
update_text_by_id id4 "item 2 v0"
vsim mounted idx=2 key=2 size=40 -> n4 scope=2

== bump shared version (live rows update in creation order) ==
update_text_by_id id3 "item 1 v1"
update_text_by_id id2 "item 0 v1"
update_text_by_id id4 "item 2 v1"

== measure row 0 (Measured-mode feedback) ==
vsim measured key=0 scope=0 55

== scroll to 1..3 (row 0 released, its reactivity freed) ==
vsim window 1..3 count=3 keys=[1, 2]
vsim release key=0 scope=0
release_text_id id2

== bump version again (released row must NOT update) ==
update_text_by_id id3 "item 1 v2"
update_text_by_id id4 "item 2 v2"

== scroll back to 0..3 (row 0 remounts at measured size 55) ==
vsim window 0..3 count=3 keys=[0, 1, 2]
create n5 text+id5 ""
update_text_by_id id5 "item 0 v2"
vsim mounted idx=0 key=0 size=55 -> n5 scope=3

== shrink data to 2 rows (one data-changed notification) ==
virtualizer_data_changed n1

== re-window after shrink (row key=2 released) ==
vsim window 0..2 count=2 keys=[0, 1]
vsim release key=2 scope=2
release_text_id id4

== clear window (remaining rows released) ==
vsim window 0..0 count=2 keys=[]
vsim release key=1 scope=1
release_text_id id3
vsim release key=0 scope=3
release_text_id id5

== swap out (unstyle then release_virtualizer) ==
remove_child n0 -x n1
release_virtualizer n1
on_node_unstyled n1
create n6 text "gone"
insert_at n0 <- n6 @ 0
