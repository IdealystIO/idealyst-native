# scene-parity FULL-OP golden — scenario `nav_stack_push_pop`, mode `spliced`
#
# Navigator (stack, Retain): mount seats the initial screen with
# the flow-fill overlay folded into its root style digest. `push`
# mounts the detail screen and swaps the outlet (the covered
# screen's scope stays alive). `pop` releases the popped screen's
# scope FIRST (cleanup marker + on_node_unstyled before the
# reveal), then re-inserts the RETAINED home screen without a
# rebuild.
#
# Complete backend-call stream (create_*/update_*/apply_style/release_*
# + the structural ops). Node names are creation-order (n0, n1, ...).
# Owned by the OLD core; regenerate after an INTENDED walker change
# with: UPDATE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
apply_style n0 {flex_direction: Some(Column), flex_grow: Some(Literal(1.0)), width: Some(Literal(Percent(100.0))), height: Some(Literal(Percent(100.0))), min_height: Some(Literal(Px(0.0)))}
create n1 view
create n2 text "home"
insert n1 <- n2
apply_style n1 {background: Some(Literal(Color("#111111"))), flex_grow: Some(Literal(1.0)), flex_shrink: Some(Literal(1.0)), flex_basis: Some(Literal(Px(0.0))), width: Some(Literal(Percent(100.0))), min_height: Some(Literal(Px(0.0)))}
create n3 view
create n4 text "header"
insert n3 <- n4
create n5 view
mark_container n5
apply_style n5 {flex_direction: Some(Column), flex_grow: Some(Literal(1.0)), flex_shrink: Some(Literal(1.0)), flex_basis: Some(Literal(Px(0.0))), min_width: Some(Literal(Px(0.0))), min_height: Some(Literal(Px(0.0)))}
insert n3 <- n5
insert n0 <- n3
clear_children n5
insert n5 <- n1

== push detail (mount + outlet swap, home retained) ==
create n6 view
create n7 text "detail"
insert n6 <- n7
apply_style n6 {background: Some(Literal(Color("#222222"))), flex_grow: Some(Literal(1.0)), flex_shrink: Some(Literal(1.0)), flex_basis: Some(Literal(Px(0.0))), width: Some(Literal(Percent(100.0))), min_height: Some(Literal(Px(0.0)))}
clear_children n5
insert n5 <- n6

== pop (release detail FIRST, reveal retained home) ==
cleanup detail-screen
on_node_unstyled n6
clear_children n5
insert n5 <- n1
