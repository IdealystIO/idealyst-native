# scene-parity FULL-OP NEW-CORE override — scenario `full_presence_cycle`, mode `anchored`
#
# Sanctioned divergences only (README + the FULL_NEWCORE_OVERRIDES
# docs): teardown release interleaving (#5, old LIFO vs new
# creation-order effect free — same release SET, only the order
# within teardown windows); where noted, cross-effect firing order
# across sibling effects (#3); and, for the presence pairs, the
# Dyn-driver + retire-hook re-expression (#6 — hole structural
# path, retire-owned detach; identical apply_presence sequence).
# Regenerate: UPDATE_NEWCORE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 text "before"
insert n0 <- n1
create n2 presence_placeholder
create n3 anchor
insert n2 <- n3
insert n0 <- n2
create n4 text "after"
insert n0 <- n4

== show (child mounts, snaps to the enter state pre-paint) ==
create n5 text "card"
insert n3 <- n5
apply_presence n5 {opacity: Some(0.0), translate_y: Some(8.0)} snap

== frame (animate to rest with the enter transition) ==
apply_presence n5 rest 200ms EaseOut

== hide (exit transform, node still attached) ==
apply_presence n5 {opacity: Some(0.0), translate_y: Some(8.0)} 150ms EaseIn

== exit elapses (deferred detach + teardown) ==
remove_child n3 -x n5

== reshow (fresh child mounts) ==
create n6 text "card"
insert n3 <- n6
apply_presence n6 {opacity: Some(0.0), translate_y: Some(8.0)} snap
