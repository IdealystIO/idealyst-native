# scene-parity FULL-OP NEW-CORE override — scenario `full_release_on_swap`, mode `spliced`
#
# Sanctioned divergences only (README + the FULL_NEWCORE_OVERRIDES
# docs): teardown release interleaving (#5, old LIFO vs new
# creation-order effect free — same release SET, only the order
# within teardown windows); where noted, cross-effect firing order
# across sibling effects (#3); and, for the presence pairs, the
# Dyn-driver + retire-hook re-expression (#6 — hole structural
# path, retire-owned detach; identical apply_presence sequence);
# and post-freeze fixes to a SHARED runtime-shared rule constant
# (#7 — apply_style payload fields only, op stream unchanged;
# each instance is listed in the README).
# Regenerate: UPDATE_NEWCORE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 view
create n2 text+id2 ""
update_text_by_id id2 "a=1"
insert n1 <- n2
create n3 text+id3 ""
update_text_by_id id3 "b=2"
insert n1 <- n3
apply_style n1 {background: Some(Literal(Color("#606060"))), width: Some(Literal(Px(60.0)))}
attach_states n1
insert_at n0 <- n1 @ 0

== swap out (ids released + on_node_unstyled, inside the step) ==
remove_child n0 -x n1
release_text_id id2
release_text_id id3
on_node_unstyled n1
create n4 text "empty"
insert_at n0 <- n4 @ 0

== swap back in (fresh ids minted) ==
remove_child n0 -x n4
create n5 view
create n6 text+id6 ""
update_text_by_id id6 "a=1"
insert n5 <- n6
create n7 text+id7 ""
update_text_by_id id7 "b=2"
insert n5 <- n7
apply_style n5 {background: Some(Literal(Color("#606060"))), width: Some(Literal(Px(60.0)))}
attach_states n5
insert_at n0 <- n5 @ 0
