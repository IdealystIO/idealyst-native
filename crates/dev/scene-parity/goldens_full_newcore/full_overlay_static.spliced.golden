# scene-parity FULL-OP NEW-CORE override — scenario `full_overlay_static`, mode `spliced`
#
# Sanctioned divergences only (README + the FULL_NEWCORE_OVERRIDES
# docs): teardown release interleaving (#5, old LIFO vs new
# creation-order effect free — same release SET, only the order
# within teardown windows); where noted, cross-effect firing order
# across sibling effects (#3); and, for the presence pairs, the
# Dyn-driver + retire-hook re-expression (#6 — hole structural
# path, retire-owned detach; identical apply_presence sequence);
# and post-freeze fixes to a SHARED runtime-shared rule constant
# (#7 — apply_style payload fields only, op stream unchanged;
# each instance is listed in the README).
# Regenerate: UPDATE_NEWCORE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 portal target=viewport(FullScreen) on_dismiss=none trap_focus=false
create n2 pressable on_click=<fn>
create n3 view
apply_style n3 {background: Some(Literal(Color("#00000080"))), width: Some(Literal(Px(40.0)))}
insert n2 <- n3
create n4 view
apply_style n4 {position: Some(Absolute), top: Some(Literal(Px(0.0))), right: Some(Literal(Px(0.0))), bottom: Some(Literal(Px(0.0))), left: Some(Literal(Px(0.0)))}
install_touch_handler n4
insert n2 <- n4
apply_style n2 {position: Some(Absolute), top: Some(Literal(Px(0.0))), right: Some(Literal(Px(0.0))), bottom: Some(Literal(Px(0.0))), left: Some(Literal(Px(0.0))), pointer_events: Some(Auto)}
insert n1 <- n2
apply_style n1 {pointer_events: Some(None)}
insert n0 <- n1
create n5 portal target=viewport(Bottom) on_dismiss=<fn> trap_focus=true
create n6 view
create n7 text "modal body"
insert n6 <- n7
apply_style n6 {background: Some(Literal(Color("#ffffff"))), width: Some(Literal(Px(320.0))), pointer_events: Some(Auto)}
insert n5 <- n6
apply_style n5 {pointer_events: Some(None)}
insert n0 <- n5
create n8 portal target=viewport(Center) on_dismiss=none trap_focus=true
create n9 view
create n10 text "toast"
insert n9 <- n10
insert n8 <- n9
apply_style n8 {pointer_events: Some(None)}
insert n0 <- n8
create n11 portal target=anchor(side=Above align=Center offset=4) on_dismiss=none trap_focus=false
create n12 view
create n13 text "tip"
insert n12 <- n13
apply_style n12 {pointer_events: Some(Auto)}
insert n11 <- n12
apply_style n11 {pointer_events: Some(None)}
insert n0 <- n11
