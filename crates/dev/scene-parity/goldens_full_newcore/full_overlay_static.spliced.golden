# scene-parity FULL-OP NEW-CORE override — scenario `full_overlay_static`, mode `spliced`
#
# Sanctioned divergences only (README + the FULL_NEWCORE_OVERRIDES
# docs): teardown release interleaving (#5, old LIFO vs new
# creation-order effect free — same release SET, only the order
# within teardown windows); where noted, cross-effect firing order
# across sibling effects (#3); and, for the presence pairs, the
# Dyn-driver + retire-hook re-expression (#6 — hole structural
# path, retire-owned detach; identical apply_presence sequence);
# and post-freeze fixes to a SHARED runtime-shared rule constant
# (#7 — apply_style payload fields only, op stream unchanged;
# each instance is listed in the README).
# Regenerate: UPDATE_NEWCORE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 portal target=viewport(Bottom) on_dismiss=<fn> trap_focus=true
create n2 pressable on_click=<fn>
create n3 view
apply_style n3 {position: Some(Absolute), top: Some(Literal(Px(0.0))), right: Some(Literal(Px(0.0))), bottom: Some(Literal(Px(0.0))), left: Some(Literal(Px(0.0)))}
install_touch_handler n3
insert n2 <- n3
apply_style n2 {background: Some(Literal(Color("#00000080"))), width: Some(Literal(Px(40.0)))}
insert n1 <- n2
create n4 view
create n5 text "modal body"
insert n4 <- n5
apply_style n4 {background: Some(Literal(Color("#ffffff"))), width: Some(Literal(Px(320.0)))}
insert n1 <- n4
insert n0 <- n1
create n6 portal target=viewport(Center) on_dismiss=none trap_focus=true
create n7 view
create n8 text "toast"
insert n7 <- n8
insert n6 <- n7
apply_style n6 {pointer_events: Some(None)}
insert n0 <- n6
create n9 portal target=anchor(side=Above align=Center offset=4) on_dismiss=none trap_focus=false
create n10 view
create n11 text "tip"
insert n10 <- n11
insert n9 <- n10
insert n0 <- n9
