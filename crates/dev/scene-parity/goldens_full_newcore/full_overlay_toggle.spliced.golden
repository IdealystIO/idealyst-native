# scene-parity FULL-OP NEW-CORE override — scenario `full_overlay_toggle`, mode `spliced`
#
# Sanctioned divergences only (README + the FULL_NEWCORE_OVERRIDES
# docs): teardown release interleaving (#5, old LIFO vs new
# creation-order effect free — same release SET, only the order
# within teardown windows); where noted, cross-effect firing order
# across sibling effects (#3); and, for the presence pairs, the
# Dyn-driver + retire-hook re-expression (#6 — hole structural
# path, retire-owned detach; identical apply_presence sequence).
# Regenerate: UPDATE_NEWCORE_GOLDENS=1 cargo test -p scene-parity

== mount ==
create n0 view
create n1 portal target=viewport(Center) on_dismiss=<fn> trap_focus=true
create n2 pressable on_click=<fn>
apply_style n2 {background: Some(Literal(Color("#00000080"))), width: Some(Literal(Px(40.0)))}
insert n1 <- n2
create n3 view
create n4 text "modal body"
insert n3 <- n4
insert n1 <- n3
insert_at n0 <- n1 @ 0

== close (backdrop unstyle + release_portal in one window) ==
remove_child n0 -x n1
on_node_unstyled n2
release_portal n1
create n5 text "closed"
insert_at n0 <- n5 @ 0

== reopen ==
remove_child n0 -x n5
create n6 portal target=viewport(Center) on_dismiss=<fn> trap_focus=true
create n7 pressable on_click=<fn>
apply_style n7 {background: Some(Literal(Color("#00000080"))), width: Some(Literal(Px(40.0)))}
insert n6 <- n7
create n8 view
create n9 text "modal body"
insert n8 <- n9
insert n6 <- n8
insert_at n0 <- n6 @ 0
